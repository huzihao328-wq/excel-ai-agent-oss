{
  "name": "excel-ai-agent",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Excel AI Agent - 在 Excel 任务窗格里用自然语言处理数据的智能助手",
  "scripts": {
    "postinstall": "node scripts/gen-icons.js",
    "dev-server": "webpack serve --mode development",
    "build": "node scripts/vendor-office-js.js && webpack --mode production",
    "start": "node scripts/ensure-loopback.js && office-addin-debugging start manifest.xml --app Excel --no-debug",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "serve": "node scripts/serve-dist.js",
    "register": "office-addin-dev-settings register manifest.xml",
    "unregister": "office-addin-dev-settings unregister manifest.xml",
    "install-addin": "npm run build && node scripts/install-persistent.js",
    "uninstall-addin": "node scripts/install-persistent.js remove",
    "pack": "node scripts/pack.js",
    "pack:src": "node scripts/pack.js --src",
    "gen-fixtures": "node tests/generate-fixtures.mjs",
    "validate-cases": "node tests/validate-cases.mjs",
    "test:runtime": "node --test tests/agent-runtime.cjs tests/error-explain-runtime.cjs tests/model-capabilities-runtime.cjs tests/excel-tools-runtime.cjs tests/checkpoint-runtime.cjs tests/storage-runtime.cjs tests/reshape-runtime.cjs tests/skills-runtime.cjs tests/range-links-runtime.cjs tests/script-sandbox-runtime.cjs tests/report-tools-runtime.cjs"
  },
  "files": [
    "src",
    "scripts",
    "assets",
    "tests",
    ".cursor",
    "manifest.xml",
    "webpack.config.js",
    "tsconfig.json",
    "README.md",
    "AGENTS.md",
    "INSTALL.AGENT.md",
    ".gitignore"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dompurify": "^3.1.6",
    "marked": "^13.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@microsoft/office-js": "^1.1.110",
    "@types/dompurify": "^3.0.5",
    "@types/office-js": "^1.0.377",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-debugging": "^5.1.6",
    "office-addin-dev-certs": "^1.13.3",
    "office-addin-dev-settings": "^3.1.2",
    "office-addin-manifest": "^1.13.6",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
